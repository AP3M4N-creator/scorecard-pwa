{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scorecard",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),T={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.png':'image/png','.woff2':'font/woff2'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const F=p.join(process.cwd(),p.normalize(u).replace(/^(\\.\\.[\\/\\\\])+/,''));f.readFile(F,(e,b)=>{if(e){s.writeHead(404);s.end('not found');return}s.writeHead(200,{'Content-Type':T[p.extname(F)]||'application/octet-stream','Cache-Control':'no-store'});s.end(b)})}).listen(process.env.PORT||8765,function(){console.log('serving on http://localhost:'+this.address().port)})"
      ],
      "port": 8765,
      "autoPort": true
    }
  ]
}
